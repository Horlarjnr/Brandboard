# Supabase / PostgreSQL connection options.
# Use either a single DATABASE_URL or the component variables below.
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname?sslmode=require
user=postgres.[PROJECT-REF]
password=
host=aws-0-[REGION].pooler.supabase.com
port=5432
dbname=postgres
STORAGE_ROOT=./storage
OPENROUTER_API_KEY=
MODEL_BRIEF=
MODEL_ART=
GENERATION_RATE_LIMIT=10
DAILY_PROJECT_GENERATION_CAP=50
