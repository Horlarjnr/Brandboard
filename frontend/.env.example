# Base URL the app calls. "/api" is proxied to https://brandboard.onrender.com
# (vite.config.js in dev, vercel.json / public/_redirects in production).
# To call the backend directly instead: https://brandboard.onrender.com
# (that needs CORSMiddleware in backend/app/main.py).
VITE_API_URL=/api
# true  = use the built-in mock API (no backend needed)
# false = call the real backend
VITE_USE_MOCK=false
